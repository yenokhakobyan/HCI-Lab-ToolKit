[Unit]
Description=HCI Analytics Dashboard
After=network.target

[Service]
Type=simple
User=hci
Group=hci
WorkingDirectory=/opt/hci-toolkit
EnvironmentFile=/opt/hci-toolkit/.env
ExecStart=/opt/hci-toolkit/venv/bin/streamlit run src/analysis/dashboard.py \
    --server.port 8502 \
    --server.address 127.0.0.1 \
    --server.headless true \
    --browser.gatherUsageStats false
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
