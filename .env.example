# HCI ToolKit Configuration
# Copy to .env and adjust values for your deployment

# Collector server
HCI_HOST=0.0.0.0
HCI_PORT=8000
HCI_DATA_DIR=/opt/hci-toolkit/data/raw/web_hci
HCI_SSL_ENABLED=false
HCI_SSL_CERTFILE=
HCI_SSL_KEYFILE=
HCI_ENABLE_EMOTION=true
HCI_ENABLE_L2CS=false
HCI_SCREEN_WIDTH=1920
HCI_SCREEN_HEIGHT=1080
HCI_DEBUG=false

# CORS (comma-separated origins, empty = same-origin only)
HCI_CORS_ORIGINS=

# Analytics dashboard
HCI_DASHBOARD_PORT=8502
